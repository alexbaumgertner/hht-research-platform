{
  "name": "@hht/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "seed:public-feed": "tsx src/scripts/seed-public-feed.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.ts --passWithNoTests",
    "test:e2e": "playwright test --config=playwright.config.ts"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.64",
    "@hht/shared": "workspace:*",
    "@mantine/core": "^7.17.1",
    "@mantine/hooks": "^7.17.1",
    "@payloadcms/db-postgres": "^3.49.0",
    "@payloadcms/email-resend": "^3.49.0",
    "@payloadcms/next": "^3.49.0",
    "@payloadcms/richtext-lexical": "^3.49.0",
    "@payloadcms/ui": "^3.49.0",
    "ai": "^7.0.79",
    "cross-env": "^7.0.3",
    "graphql": "^16.10.0",
    "next": "16.2.6",
    "next-intl": "^4.1.0",
    "payload": "^3.49.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.33.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.22.0",
    "eslint-config-next": "16.2.6",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
