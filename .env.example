# Database (Neon Postgres)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Payload CMS
PAYLOAD_SECRET=replace-with-long-random-string
PAYLOAD_API_KEY=replace-with-worker-api-key

# Public site URL (no trailing slash)
PUBLIC_SITE_URL=http://localhost:3000

# Vercel AI Gateway
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-4o-mini

# Resend (optional for email notifications)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Research Monitoring

# Worker defaults
BOOTSTRAP_LOOKBACK_DAYS=30
BATCH_SIZE_PER_SOURCE=50
# WORKER_STUB_EXIT=1

# SSRF controls for worker outbound fetch (RSS and other adapters)
# Comma-separated host allowlist; when set, only these hosts are fetched
# RSS_HOST_ALLOWLIST=pubmed.ncbi.nlm.nih.gov,clinicaltrials.gov,feeds.example.com
# Set to 1 only for local development against localhost feeds
# ALLOW_PRIVATE_NETWORK_FETCH=1

# Pre-generate content-translations at digest publish (default: on)
# TRANSLATE_ON_PUBLISH=0

# Seed script (optional)
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=ChangeMe123!

# Playwright
PLAYWRIGHT_BASE_URL=http://localhost:3000
