# Database. Local development: the docker compose Postgres (`docker compose up -d`).
# Never point local tooling at production: `next dev` pushes schema changes and the seed
# script writes demo rows; both refuse non-local hosts (see apps/web/src/lib/databaseTarget.ts).
DATABASE_URL=postgres://payload:payload@localhost:5432/payload

# Payload CMS
PAYLOAD_SECRET=replace-with-long-random-string
PAYLOAD_API_KEY=replace-with-worker-api-key

# Public site URL (no trailing slash)
PUBLIC_SITE_URL=http://localhost:3000

# Vercel AI Gateway
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-4o-mini

# Resend (optional for email notifications)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Research Monitoring
# Svix signing secret (`whsec_…`) for POST /api/webhooks/resend. Web only.
# Absent → that route responds 400 and writes nothing.
RESEND_WEBHOOK_SECRET=
# EMAIL_DELIVERY=stub records messages in memory and does not call Resend.
# Honored only when VERCEL_ENV is not production.
# EMAIL_DELIVERY=stub
# RESEND_FROM_EMAIL must leave @resend.dev before anyone except the project
# owner is stored or mailed. Until then the sandbox gate discards other addresses.

# VK community token for the worker's wall.post. Worker only — never the web app,
# never the admin, never logs. Empty means VK posting is off.
# VK_COMMUNITY_TOKEN=

# Worker defaults
BOOTSTRAP_LOOKBACK_DAYS=30
BATCH_SIZE_PER_SOURCE=50
# WORKER_STUB_EXIT=1

# SSRF controls for worker outbound fetch (RSS and other adapters)
# Comma-separated host allowlist; when set, only these hosts are fetched
# RSS_HOST_ALLOWLIST=pubmed.ncbi.nlm.nih.gov,clinicaltrials.gov,feeds.example.com
# Set to 1 only for local development against localhost feeds
# ALLOW_PRIVATE_NETWORK_FETCH=1

# Pre-generate content-translations at digest publish (default: on)
# TRANSLATE_ON_PUBLISH=0

# Seed script (optional)
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=ChangeMe123!

# Playwright
PLAYWRIGHT_BASE_URL=http://localhost:3000
